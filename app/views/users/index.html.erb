<%= render 'books/template', book: @book %>

<h1>users</h1>
<table class="table">
  <thead>
    <tr>
      <th>image</th>
      <th>name</th>
      <th></th>
    </tr>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= image_tag user.get_profile_image(100, 100) %></td>
        <td><%= link_to user.name, user_path(user.id) %></td>
      </tr>
    <% end %>
  </tbody>
</table>