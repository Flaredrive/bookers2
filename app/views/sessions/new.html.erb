<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0">
      <h2>Log in</h2>
      <%= form_with url: session_path do |f| %>
        <%= f.label :name %><br>
        <%= f.text_field :name, required: true, autofocus: true, autocomplete: "username", value: params[:name] %><br>
        <%= f.label :password %><br>
        <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %><br>
        <%= f.submit "Sign in" %>
      <% end %>
    </div>
    <div class="col-12 mt-3">
      <%= link_to "Sign up", new_user_path %><br>
      <%= link_to "Forgot password?", new_password_path %>
    </div>
  </div>
</div>